# Vorlage: kopieren nach .env.local und mit den Werten aus der Firebase-Konsole füllen
# (Projekteinstellungen → Allgemein → Meine Apps → Web-App → SDK-Konfiguration).
# Diese Werte sind nicht geheim – der Schutz der Daten erfolgt über Login + firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
