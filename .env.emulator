# Lokale Entwicklung gegen die Firebase Emulator Suite (npm run emulators + npm run dev:emulator).
# Keine echten Zugangsdaten nötig.
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-ruesthaus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-ruesthaus
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
